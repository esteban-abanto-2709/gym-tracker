# Works as is for local development: cp .env.example .env

# PostgreSQL Database (applied only when the volume is first created)
POSTGRES_DB=gym_tracker
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Database connection for API (Internal Docker Network)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Direct connection for migrations (same in-network Postgres; Prisma requires both vars)
DIRECT_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Origin allowed by the API's CORS
FRONTEND_URL=http://localhost:3000

# Secret used to sign auth JWTs (a long random string on a real server)
JWT_SECRET=local-development-only-secret

# Google OAuth Client ID (optional; without it, sign in with email and password)
GOOGLE_CLIENT_ID=

# Cloudflare Tunnel (optional): set COMPOSE_PROFILES=tunnel and the tunnel token
COMPOSE_PROFILES=
TUNNEL_TOKEN=

# Server only: use the production overrides instead of compose.override.yaml
# COMPOSE_FILE=compose.yaml:compose.prod.yaml
