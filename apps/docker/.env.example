# PostgreSQL Database
POSTGRES_DB=gym_tracker
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Database connection for API (Internal Docker Network)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Direct connection for migrations (same in-network Postgres; Prisma requires both vars)
DIRECT_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# IANA timezone used to group/filter workouts by local day
APP_TIMEZONE=America/Lima

# Cloudflare Tunnel token (exposes only the web service to the internet)
TUNNEL_TOKEN=
