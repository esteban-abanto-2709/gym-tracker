generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Exercise {
  id        String    @id @default(uuid())
  name      String    @unique
  equipment String
  workouts  Workout[]
  createdAt DateTime  @default(now())
}

model Workout {
  id         String   @id @default(uuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  weight     Float
  reps       Int
  opinion    String
  createdAt  DateTime @default(now())
}
