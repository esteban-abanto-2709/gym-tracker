generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  username        String
  slug            String            @unique
  passwordHash    String?
  googleId        String?           @unique
  workouts        Workout[]
  routines        Routine[]
  programs        Program[]         @relation("UserPrograms")
  activeProgramId String?
  activeProgram   Program?          @relation("ActiveProgram", fields: [activeProgramId], references: [id], onDelete: SetNull)
  birthDate       DateTime?         @db.Date
  exerciseLocale  Locale            @default(en)
  newsOpened      String[]          @default([])
  newsSeen        String[]          @default([])
  measurements    BodyMeasurement[]
  exercises       Exercise[]
  createdAt       DateTime          @default(now())
}

model BodyMeasurement {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  weightKg   Float?
  bodyFatPct Float?
  heightCm   Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
}

model Program {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("UserPrograms", fields: [userId], references: [id])
  name         String
  copiedFromId String?
  copiedFrom   Program?  @relation("ProgramCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies       Program[] @relation("ProgramCopies")
  routines     Routine[]
  activeFor    User[]    @relation("ActiveProgram")
  createdAt    DateTime  @default(now())

  @@unique([userId, name])
}

model Exercise {
  id               String         @id @default(uuid())
  slug             String         @unique
  primaryMuscles   Muscle[]       @default([])
  secondaryMuscles Muscle[]       @default([])
  mechanic         Mechanic?
  createdById      String?
  createdBy        User?          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  names            ExerciseName[]
  workouts         Workout[]
  routineItems     RoutineItem[]
  createdAt        DateTime       @default(now())
}

model ExerciseName {
  id         String   @id @default(uuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  locale     Locale
  name       String
  searchName String

  @@unique([exerciseId, locale])
  @@index([searchName])
}

enum Locale {
  es
  en
}

enum Muscle {
  ABDOMINALS
  ABDUCTORS
  ADDUCTORS
  BICEPS
  CALVES
  CHEST
  FOREARMS
  GLUTES
  HAMSTRINGS
  LATS
  LOWER_BACK
  MIDDLE_BACK
  NECK
  QUADRICEPS
  TRAPS
  TRICEPS
  FRONT_DELTS
  SIDE_DELTS
  REAR_DELTS
}

enum Mechanic {
  COMPOUND
  ISOLATION
}

model Equipment {
  id       String    @id @default(uuid())
  name     String    @unique
  workouts Workout[]
}

model Workout {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  exerciseId  String
  exercise    Exercise   @relation(fields: [exerciseId], references: [id])
  routineId   String?
  routine     Routine?   @relation(fields: [routineId], references: [id], onDelete: SetNull)
  weight      Float?
  reps        Int?
  durationSec Int?
  opinion     String
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  setType     SetType    @default(WORKING)
  step        Int?
  createdAt   DateTime   @default(now())
}

enum SetType {
  WORKING
  WARMUP
  RAMP
}

model Routine {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  name            String
  programId       String?
  program         Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  programPosition Int?
  items           RoutineItem[]
  workouts        Workout[]
  createdAt       DateTime      @default(now())

  @@unique([userId, name])
}

model RoutineItem {
  id         String   @id @default(uuid())
  routineId  String
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  position   Int
  blocks     Json     @default("[]")
  createdAt  DateTime @default(now())
}
