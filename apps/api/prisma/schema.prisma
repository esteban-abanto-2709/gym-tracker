generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Exercise {
  id           String        @id @default(uuid())
  name         String        @unique
  equipment    String
  workouts     Workout[]
  routineItems RoutineItem[]
  createdAt    DateTime      @default(now())
}

model Workout {
  id         String   @id @default(uuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  routineId  String?
  routine    Routine? @relation(fields: [routineId], references: [id], onDelete: SetNull)
  weight     Float
  reps       Int
  opinion    String
  createdAt  DateTime @default(now())
}

model Routine {
  id        String        @id @default(uuid())
  name      String        @unique
  items     RoutineItem[]
  workouts  Workout[]
  createdAt DateTime      @default(now())
}

model RoutineItem {
  id         String   @id @default(uuid())
  routineId  String
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  position   Int
  targetSets Int?
  targetReps Int?
  createdAt  DateTime @default(now())
}
